@{
    // Set ViewData["Bare"] = true on pages like Login that must not show the app shell.
    var bare = ViewData["Bare"] as bool? ?? false;
    var controller = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
    var userName = User?.Identity?.IsAuthenticated == true ? User.Identity!.Name : "Guest";
    var initials = string.IsNullOrWhiteSpace(userName) ? "G" : userName!.Trim().Substring(0, 1).ToUpper();

    var role = User.IsInRole("Admin")        ? "Admin"
             : User.IsInRole("Hod")          ? "Hod"
             : User.IsInRole("Manager")      ? "Manager"
             : User.IsInRole("Receptionist") ? "Receptionist"
             : User.IsInRole("Client")       ? "Client"
             : "";

    var roleLabel = role switch
    {
        "Admin"        => "Administrator",
        "Hod"          => "Head of Department",
        "Manager"      => "Manager",
        "Receptionist" => "Receptionist",
        "Client"       => "Client",
        _              => ""
    };

    // Menu items — (Group, Label, Href, Ctrl, Icon, Tone)
    var menu = new List<(string Group, string Label, string Href, string Ctrl, string Icon, string Tone)>();

    if (role == "Admin")
    {
        menu.Add(("Overview", "Dashboard",   "~/Admin/Dashboard",     "Admin",      "i-dashboard", "#48dbfb"));
        menu.Add(("Manage",   "Clients",     "~/Clients",             "Clients",    "i-users",     "#7ee0a5"));
        menu.Add(("Manage",   "Properties",  "~/Properties",          "Properties", "i-building",  "#feca57"));
        menu.Add(("Manage",   "Approvals",   "~/Approvals",           "Approvals",  "i-clipboard", "#a29bfe"));
        menu.Add(("Finance",  "Payments",    "~/Payments",            "Payments",   "i-wallet",    "#7ee0a5"));
        menu.Add(("Finance",  "Reports",     "~/Reports",             "Reports",    "i-chart",     "#ff9ff3"));
        menu.Add(("System",   "Settings",    "~/Settings",            "Settings",   "i-settings",  "#48dbfb"));
    }
    else if (role == "Hod")
    {
        menu.Add(("Overview", "Dashboard",   "~/Hod/Dashboard",       "Hod",        "i-dashboard", "#48dbfb"));
        menu.Add(("Manage",   "Approvals",   "~/Approvals",           "Approvals",  "i-clipboard", "#a29bfe"));
        menu.Add(("Manage",   "Properties",  "~/Properties",          "Properties", "i-building",  "#feca57"));
        menu.Add(("Reports",  "Reports",     "~/Reports",             "Reports",    "i-chart",     "#ff9ff3"));
    }
    else if (role == "Manager")
    {
        menu.Add(("Overview", "Dashboard",   "~/Manager/Dashboard",   "Manager",    "i-dashboard", "#48dbfb"));
        menu.Add(("Manage",   "Clients",     "~/Clients",             "Clients",    "i-users",     "#7ee0a5"));
        menu.Add(("Manage",   "Properties",  "~/Properties",          "Properties", "i-building",  "#feca57"));
        menu.Add(("Manage",   "Deals",       "~/Deals",               "Deals",      "i-key",       "#a29bfe"));
        menu.Add(("Finance",  "Payments",    "~/Payments",            "Payments",   "i-wallet",    "#7ee0a5"));
    }
    else if (role == "Receptionist")
    {
        menu.Add(("Overview",  "Dashboard",  "~/Reception/Dashboard", "Reception",  "i-dashboard", "#48dbfb"));
        menu.Add(("Front desk","Clients",    "~/Clients",             "Clients",    "i-users",     "#7ee0a5"));
        menu.Add(("Front desk","Requests",   "~/Requests",            "Requests",   "i-clipboard", "#a29bfe"));
    }
    else if (role == "Client")
    {
        menu.Add(("Overview", "Dashboard",   "~/Client/Dashboard",    "Client",     "i-dashboard", "#48dbfb"));
        menu.Add(("My home",  "My property", "~/MyProperty",          "MyProperty", "i-building",  "#feca57"));
        menu.Add(("My home",  "Rent",        "~/Rent",                "Rent",       "i-wallet",    "#7ee0a5"));
        menu.Add(("My home",  "Requests",    "~/Requests",            "Requests",   "i-clipboard", "#a29bfe"));
    }
    else
    {
        menu.Add(("Overview", "Dashboard",   "~/",                    "Home",       "i-dashboard", "#48dbfb"));
    }

    string Active(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0d1530" />
    <title>@ViewData["Title"] - Multiverse</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Multiverse.Web.styles.css" asp-append-version="true" />

    @* Restore the collapsed-sidebar choice before first paint so the layout doesn't jump. *@
    <script>
        try { if (localStorage.getItem('erp-collapsed') === '1') document.documentElement.classList.add('erp-collapsed'); } catch (e) { }
    </script>
</head>
<body class="@(bare ? "erp-bare" : "erp-shell")">

@* ---------- Icon sprite (no external icon library needed) ---------- *@
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
        <symbol id="i-dashboard" viewBox="0 0 24 24"><path d="M4 13h6V4H4v9Zm0 7h6v-5H4v5Zm10 0h6v-9h-6v9Zm0-16v5h6V4h-6Z" fill="currentColor"/></symbol>
        <symbol id="i-building" viewBox="0 0 24 24"><path d="M4 21V5l8-3 8 3v16h-6v-5h-4v5H4Zm4-12h2V7H8v2Zm6 0h2V7h-2v2Zm-6 4h2v-2H8v2Zm6 0h2v-2h-2v2Z" fill="currentColor"/></symbol>
