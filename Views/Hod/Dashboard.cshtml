@{ ViewData["Title"] = "HOD Dashboard"; }
<div class="erp-page-header"><div><h2>Head of Department</h2><p>Approvals and team overview</p></div></div>
<div class="erp-grid erp-grid-kpi">
    <div class="erp-card tone" style="--tone:#a29bfe">
        <div class="erp-card-icon" style="--tone:#a29bfe"><svg><use href="#i-clipboard"/></svg></div>
        <div class="erp-card-label">Pending approvals</div><div class="erp-card-value">0</div>
    </div>
    <div class="erp-card tone" style="--tone:#48dbfb">
        <div class="erp-card-icon" style="--tone:#48dbfb"><svg><use href="#i-users"/></svg></div>
        <div class="erp-card-label">Team members</div><div class="erp-card-value">0</div>
    </div>
</div>