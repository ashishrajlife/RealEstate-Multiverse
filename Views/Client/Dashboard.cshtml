@{ ViewData["Title"] = "Client Dashboard"; }
<div class="erp-page-header"><div><h2>My Home</h2><p>Your property, rent and requests</p></div></div>
<div class="erp-grid erp-grid-kpi">
    <div class="erp-card tone" style="--tone:#feca57">
        <div class="erp-card-icon" style="--tone:#feca57"><svg><use href="#i-building"/></svg></div>
        <div class="erp-card-label">My property</div><div class="erp-card-value">—</div>
    </div>
    <div class="erp-card tone" style="--tone:#7ee0a5">
        <div class="erp-card-icon" style="--tone:#7ee0a5"><svg><use href="#i-wallet"/></svg></div>
        <div class="erp-card-label">Rent due</div><div class="erp-card-value">$0</div>
    </div>
</div>